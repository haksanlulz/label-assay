{
  "schema_version": 1,
  "rulebook_version": "d0550ba69224",
  "scope": "Synthetic text and supplied OCR evidence; no vision accuracy or boldness measurement.",
  "cases": [
    {
      "id": "matching-text",
      "input": {
        "brand": "Example Spirits",
        "application_brand": "Example Spirits",
        "alcohol": "40% ALC/VOL (80 PROOF)",
        "warning": "reference",
        "ocr": "none"
      },
      "expected": {
        "health_warning_verbatim": "pass",
        "health_warning_bold": "not_evaluable",
        "brand_name_matches_application": "pass",
        "alcohol_content_internally_consistent": "pass"
      },
      "verdict": "pass",
      "expected_evidence": {
        "health_warning_verbatim": {
          "detail": "Matches the mandated warning: word-for-word, with the heading in capital letters.",
          "diff": []
        }
      }
    },
    {
      "id": "wrong-brand",
      "input": {
        "brand": "Different Distillery",
        "application_brand": "Example Spirits",
        "alcohol": "40% ALC/VOL (80 PROOF)",
        "warning": "reference",
        "ocr": "none"
      },
      "expected": {
        "health_warning_verbatim": "pass",
        "health_warning_bold": "not_evaluable",
        "brand_name_matches_application": "fail",
        "alcohol_content_internally_consistent": "pass"
      },
      "verdict": "fail",
      "expected_evidence": {
        "brand_name_matches_application": {
          "detail": "Brand names differ ('different distillery' vs 'example spirits').",
          "diff": []
        }
      }
    },
    {
      "id": "missing-brand",
      "input": {
        "brand": null,
        "application_brand": "Example Spirits",
        "alcohol": "40% ALC/VOL (80 PROOF)",
        "warning": "reference",
        "ocr": "none"
      },
      "expected": {
        "health_warning_verbatim": "pass",
        "health_warning_bold": "not_evaluable",
        "brand_name_matches_application": "needs_review",
        "alcohol_content_internally_consistent": "pass"
      },
      "verdict": "needs_review",
      "expected_evidence": {
        "brand_name_matches_application": {
          "detail": "Brand name missing on the label or the application.",
          "diff": []
        }
      }
    },
    {
      "id": "no-filed-brand",
      "input": {
        "brand": "Example Spirits",
        "application_brand": "",
        "alcohol": "40% ALC/VOL (80 PROOF)",
        "warning": "reference",
        "ocr": "none"
      },
      "expected": {
        "health_warning_verbatim": "pass",
        "health_warning_bold": "not_evaluable",
        "brand_name_matches_application": "not_evaluable",
        "alcohol_content_internally_consistent": "pass"
      },
      "verdict": "pass",
      "expected_evidence": {
        "brand_name_matches_application": {
          "detail": "No application brand name was provided to compare against.",
          "diff": []
        }
      }
    },
    {
      "id": "proof-disagrees",
      "input": {
        "brand": "Example Spirits",
        "application_brand": "Example Spirits",
        "alcohol": "40% ALC/VOL (70 PROOF)",
        "warning": "reference",
        "ocr": "none"
      },
      "expected": {
        "health_warning_verbatim": "pass",
        "health_warning_bold": "not_evaluable",
        "brand_name_matches_application": "pass",
        "alcohol_content_internally_consistent": "fail"
      },
      "verdict": "fail",
      "expected_evidence": {
        "alcohol_content_internally_consistent": {
          "detail": "The stated proof (70) does not equal twice the alcohol by volume (40).",
          "diff": []
        }
      }
    },
    {
      "id": "missing-alcohol",
      "input": {
        "brand": "Example Spirits",
        "application_brand": "Example Spirits",
        "alcohol": null,
        "warning": "reference",
        "ocr": "none"
      },
      "expected": {
        "health_warning_verbatim": "pass",
        "health_warning_bold": "not_evaluable",
        "brand_name_matches_application": "pass",
        "alcohol_content_internally_consistent": "needs_review"
      },
      "verdict": "needs_review",
      "expected_evidence": {
        "alcohol_content_internally_consistent": {
          "detail": "Could not read the alcohol content to check it.",
          "diff": []
        }
      }
    },
    {
      "id": "lowercase-heading",
      "input": {
        "brand": "Example Spirits",
        "application_brand": "Example Spirits",
        "alcohol": "40% ALC/VOL (80 PROOF)",
        "warning": "lowercase_heading",
        "ocr": "none"
      },
      "expected": {
        "health_warning_verbatim": "fail",
        "health_warning_bold": "not_evaluable",
        "brand_name_matches_application": "pass",
        "alcohol_content_internally_consistent": "pass"
      },
      "verdict": "fail",
      "expected_evidence": {
        "health_warning_verbatim": {
          "detail": "Wording is correct, but the heading is printed as \"Government Warning:\": the two heading words must be in capital letters (27 CFR 16.22(a)(2)).",
          "diff": [
            [
              "replace",
              "GOVERNMENT WARNING:",
              "Government Warning:"
            ]
          ]
        }
      }
    },
    {
      "id": "altered-warning",
      "input": {
        "brand": "Example Spirits",
        "application_brand": "Example Spirits",
        "alcohol": "40% ALC/VOL (80 PROOF)",
        "warning": "altered",
        "ocr": "none"
      },
      "expected": {
        "health_warning_verbatim": "fail",
        "health_warning_bold": "not_evaluable",
        "brand_name_matches_application": "pass",
        "alcohol_content_internally_consistent": "pass"
      },
      "verdict": "fail",
      "expected_evidence": {
        "health_warning_verbatim": {
          "detail": "Warning text differs from the mandated statement — a word is changed, missing, or added.",
          "diff": [
            [
              "replace",
              "problems.",
              "changed."
            ]
          ]
        }
      }
    },
    {
      "id": "missing-warning",
      "input": {
        "brand": "Example Spirits",
        "application_brand": "Example Spirits",
        "alcohol": "40% ALC/VOL (80 PROOF)",
        "warning": "missing",
        "ocr": "none"
      },
      "expected": {
        "health_warning_verbatim": "needs_review",
        "health_warning_bold": "not_evaluable",
        "brand_name_matches_application": "pass",
        "alcohol_content_internally_consistent": "pass"
      },
      "verdict": "needs_review",
      "expected_evidence": {
        "health_warning_verbatim": {
          "detail": "No Government Warning text was found.",
          "diff": []
        }
      }
    },
    {
      "id": "independent-ocr-match",
      "input": {
        "brand": "Example Spirits",
        "application_brand": "Example Spirits",
        "alcohol": "40% ALC/VOL (80 PROOF)",
        "warning": "reference",
        "ocr": "match"
      },
      "expected": {
        "health_warning_verbatim": "pass",
        "health_warning_bold": "not_evaluable",
        "brand_name_matches_application": "pass",
        "alcohol_content_internally_consistent": "pass"
      },
      "verdict": "pass",
      "expected_evidence": {
        "health_warning_verbatim": {
          "detail": "Matches the mandated warning: word-for-word, with the heading in capital letters.",
          "diff": []
        }
      }
    },
    {
      "id": "recited-warning",
      "input": {
        "brand": "Example Spirits",
        "application_brand": "Example Spirits",
        "alcohol": "40% ALC/VOL (80 PROOF)",
        "warning": "reference",
        "ocr": "contradict_warning"
      },
      "expected": {
        "health_warning_verbatim": "needs_review",
        "health_warning_bold": "not_evaluable",
        "brand_name_matches_application": "pass",
        "alcohol_content_internally_consistent": "pass"
      },
      "verdict": "needs_review",
      "expected_evidence": {
        "health_warning_verbatim": {
          "detail": "The reader's transcription matches the mandated warning, but an independent scan of the image did not confirm the statement word-for-word, so a person should verify it.",
          "diff": []
        }
      }
    },
    {
      "id": "unconfirmed-brand",
      "input": {
        "brand": "Example Spirits",
        "application_brand": "Example Spirits",
        "alcohol": "40% ALC/VOL (80 PROOF)",
        "warning": "reference",
        "ocr": "contradict_brand"
      },
      "expected": {
        "health_warning_verbatim": "pass",
        "health_warning_bold": "not_evaluable",
        "brand_name_matches_application": "needs_review",
        "alcohol_content_internally_consistent": "pass"
      },
      "verdict": "needs_review",
      "expected_evidence": {
        "brand_name_matches_application": {
          "detail": "Brand names match after normalization. (Unconfirmed: a second reading of the label did not corroborate this, so a person should verify it.)",
          "diff": []
        }
      }
    }
  ]
}
